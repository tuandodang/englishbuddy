# ==============================================
# ENGLISH BUDDY - Ollama Configuration (FREE)
# ==============================================
# This is an example configuration for using Ollama
# Cost: $0 (completely free!)
# Quality: Good (Llama2)
# Runs locally on your computer

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/englishbuddy"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# ==============================================
# AI PROVIDER: Ollama (Local AI)
# ==============================================
AI_PROVIDER="ollama"

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"

# AI Model to use (llama2, mistral, codellama, etc.)
OLLAMA_MODEL="llama2"

# Alternative models:
# OLLAMA_MODEL="mistral"       # 4GB, faster
# OLLAMA_MODEL="llama2:7b-chat" # Optimized for chat
# OLLAMA_MODEL="codellama"     # Better at explanations

# Optional: Azure Speech (for pronunciation scoring)
# AZURE_SPEECH_KEY="your-azure-speech-key"
# AZURE_SPEECH_REGION="eastus"

# App Config
NEXT_PUBLIC_APP_NAME="English Buddy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================
# SETUP INSTRUCTIONS:
# ==============================================
# 1. Install Ollama:
#    macOS/Linux: curl https://ollama.ai/install.sh | sh
#    Windows: Download from https://ollama.ai/download
#
# 2. Download AI model (~7GB):
#    ollama pull llama2
#
#    Alternative models:
#    ollama pull mistral        # Lighter, faster
#    ollama pull llama2:7b-chat # Optimized
#
# 3. Verify Ollama is running:
#    ollama run llama2
#    (Type "Hello!" to test, Ctrl+D to exit)
#
# 4. Copy this file to .env:
#    cp .env.ollama .env
#
# 5. Generate NextAuth secret:
#    openssl rand -base64 32
#    Replace "your-secret-key-here" above
#
# 6. Setup database and start:
#    npx prisma migrate dev
#    npm run seed
#    npm run dev
#
# ==============================================
# SYSTEM REQUIREMENTS:
# ==============================================
# RAM: 8GB minimum (16GB recommended)
# Storage: 4-7GB for model
# CPU/GPU: Any modern processor
# Internet: Only for initial model download
#
# ==============================================
# BENEFITS:
# ==============================================
# ✅ 100% FREE forever
# ✅ No API costs
# ✅ Works offline
# ✅ Privacy-focused (data stays local)
# ✅ Unlimited usage
# ✅ Perfect for classrooms
# ==============================================
