# ==============================================
# ENGLISH BUDDY - Mock AI Configuration (DEMO)
# ==============================================
# This is an example configuration for using Mock AI
# Cost: $0 (completely free!)
# Quality: Basic (pre-defined responses)
# Perfect for testing and development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/englishbuddy"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# ==============================================
# AI PROVIDER: Mock (Demo Mode)
# ==============================================
AI_PROVIDER="mock"

# No API keys or additional setup required!
# Mock AI uses pre-defined responses

# Optional: Azure Speech (for pronunciation scoring)
# AZURE_SPEECH_KEY="your-azure-speech-key"
# AZURE_SPEECH_REGION="eastus"

# App Config
NEXT_PUBLIC_APP_NAME="English Buddy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================
# SETUP INSTRUCTIONS:
# ==============================================
# 1. Copy this file to .env:
#    cp .env.mock .env
#
# 2. Generate NextAuth secret:
#    openssl rand -base64 32
#    Replace "your-secret-key-here" above
#
# 3. Setup database and start:
#    npx prisma migrate dev
#    npm run seed
#    npm run dev
#
# That's it! No AI API keys needed!
#
# ==============================================
# WHAT YOU GET:
# ==============================================
# ✅ All app features work
# ✅ Vocabulary, pronunciation, games, stories
# ✅ AI chat with pre-defined responses
# ✅ Perfect for testing the app
# ✅ No setup complexity
# ✅ Instant start
#
# ==============================================
# LIMITATIONS:
# ==============================================
# ❌ Limited conversation ability
# ❌ Pre-defined responses only
# ❌ No real AI intelligence
# ❌ Not suitable for production
#
# ==============================================
# WHEN TO USE:
# ==============================================
# ✅ Testing the application
# ✅ Development without API keys
# ✅ Demonstrating app features
# ✅ Learning how to use the app
#
# For better quality, use:
# - OpenAI API (~$0.60/month)
# - Ollama (free, local AI)
# ==============================================
