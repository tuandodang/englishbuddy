# Database
DATABASE_URL="postgresql://user:password@localhost:5432/englishbuddy"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# ==========================================
# AI CONFIGURATION (Choose one option)
# ==========================================

# AI_PROVIDER options: 'openai', 'ollama', 'mock', 'auto' (default)
# - 'auto': Automatically selects best available (OpenAI > Ollama > Mock)
# - 'openai': Use OpenAI API (requires API key, ~$0.60/month typical usage)
# - 'ollama': Use free local AI (requires Ollama installed)
# - 'mock': Demo mode with pre-defined responses (no AI)
AI_PROVIDER="auto"

# ==========================================
# OPTION 1: OpenAI API (~$0.60/month)
# ==========================================
# Sign up: https://platform.openai.com
# Cost: GPT-4o-mini is $0.15-0.60 per million tokens
# Free: $5 credits for new users
OPENAI_API_KEY="sk-your-openai-api-key"

# ==========================================
# OPTION 2: Ollama (FREE - Runs Locally)
# ==========================================
# Install: https://ollama.ai
# Run: ollama run llama2
# Models: llama2, mistral, codellama, etc.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama2"

# ==========================================
# Azure Speech (Optional - for pronunciation)
# ==========================================
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="eastus"

# ==========================================
# App Config
# ==========================================
NEXT_PUBLIC_APP_NAME="English Buddy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
