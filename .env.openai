# ==============================================
# ENGLISH BUDDY - OpenAI Configuration
# ==============================================
# This is an example configuration for using OpenAI API
# Cost: ~$0.60/month for typical usage
# Quality: Excellent (GPT-4o-mini)

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/englishbuddy"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# ==============================================
# AI PROVIDER: OpenAI
# ==============================================
AI_PROVIDER="openai"

# Get your API key from: https://platform.openai.com
# Sign up → API Keys → Create new secret key
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Optional: Azure Speech (for pronunciation scoring)
# AZURE_SPEECH_KEY="your-azure-speech-key"
# AZURE_SPEECH_REGION="eastus"

# App Config
NEXT_PUBLIC_APP_NAME="English Buddy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================
# SETUP INSTRUCTIONS:
# ==============================================
# 1. Copy this file to .env:
#    cp .env.openai .env
#
# 2. Sign up at https://platform.openai.com
#
# 3. Create API key:
#    - Navigate to API Keys section
#    - Click "Create new secret key"
#    - Copy the key (starts with sk-)
#
# 4. Replace "sk-your-openai-api-key-here" above
#    with your actual API key
#
# 5. Set spending limits (recommended):
#    - Go to https://platform.openai.com/account/limits
#    - Set hard limit: $5/month
#    - Set soft limit: $3/month
#
# 6. Generate NextAuth secret:
#    openssl rand -base64 32
#    Replace "your-secret-key-here" above
#
# 7. Setup database and start:
#    npx prisma migrate dev
#    npm run seed
#    npm run dev
#
# ==============================================
# COST ESTIMATE:
# ==============================================
# Typical usage (30 conversations/day):
# - Cost per conversation: $0.0007
# - Daily: $0.021
# - Monthly: ~$0.60
# - Annual: ~$7
#
# Free credits: $5 for new users
# ==============================================
